{
  "name": "l-aura-palace-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Ultra-Premium White-Label Hotel Booking Ecosystem (Next.js + React Native + Express + Redux Toolkit + Prisma)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"amber,cyan\" \"npm run dev --workspace=@hotel/api\" \"npm run dev --workspace=@hotel/web\"",
    "dev:api": "npm run dev --workspace=@hotel/api",
    "dev:web": "npm run dev --workspace=@hotel/web",
    "dev:mobile": "npm run start --workspace=@hotel/mobile",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=@hotel/api",
    "db:migrate": "npm run db:migrate --workspace=@hotel/api",
    "db:seed": "npm run db:seed --workspace=@hotel/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
