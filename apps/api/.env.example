# Serveur Express API
PORT=4000

# Base de données PostgreSQL (Prisma ORM)
# Remplacez par vos identifiants PostgreSQL locaux ou distants (Supabase, Neon, RDS)
# Si PostgreSQL n'est pas encore démarré, l'API Express utilise automatiquement son moteur hybride haute-disponibilité.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/laura_palace?schema=public"
